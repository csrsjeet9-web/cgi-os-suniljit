# ============================================================
# CGI OS — environment variables
# ------------------------------------------------------------
# Copy this file to `.env` (cp .env.example .env), then fill in the values.
# `.env` is gitignored — your real keys never get committed.
#
# THREE COMMON MISTAKES that break everything (avoid them):
#   1) A trailing newline or space in a key. Copy the value EXACTLY, no extra line.
#      (A stray newline is an illegal HTTP header and crashes every request.)
#   2) Using the /rest/v1 URL. SUPABASE_URL is the BASE project URL
#      (https://xxxx.supabase.co) — NOT https://xxxx.supabase.co/rest/v1.
#   3) Using the anon / publishable key. The app needs the service_role (secret)
#      key. The anon key can't read past security rules → you'll see an empty app.
# ============================================================

# ---- Supabase (the O & E steps) ----
# Supabase → Project Settings → Data API → Project URL. Base URL only.
SUPABASE_URL=
# Supabase → Project Settings → API Keys → service_role → Reveal & copy.
# This is a SECRET (it bypasses all row security). Server-only — never in a browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- The lock on the door ----
# Any phrase you like — the passcode for the web app (see /login).
# Leave it BLANK to run with no lock (the app shows a calm setup note instead).
APP_PASSCODE=

# ---- The SECOND lock: the Investigations register ----
# A different phrase. Without it, investigation cases are invisible to everyone —
# the rows are filtered in the SQL query, so nothing about them reaches a page.
# Leave BLANK to keep that register closed to all web users.
RESTRICTED_PASSCODE=
# Telegram ids allowed to ask the bot about investigations (comma-separated).
# Everyone else gets "not cleared" — never a partial answer. Leave blank for nobody.
RESTRICTED_USER_IDS=

# ---- Claude (the brain) ----
# console.anthropic.com → API Keys. Powers Atlas, the Regulatory Watch and the
# monthly narrative. Missing? Every AI surface degrades to a calm message — never a crash.
ANTHROPIC_API_KEY=
# Optional model overrides. Defaults: bot/email = claude-haiku-4-5,
# regulatory watch + monthly narrative = claude-sonnet-5.
CLAUDE_MODEL=
CLAUDE_WATCH_MODEL=

# ---- THE AUTONOMY DIAL ----
# The severity at which a robot must ASK before it acts: Critical | High | Medium | Low.
# At or above this line — and anything overdue — always asks. Below it, the robot
# acts and tells you, with /undo. Default High. Closures ALWAYS ask, whatever this says.
APPROVAL_LEVEL=High

# ---- Telegram (Atlas) ----
# Talk to @BotFather → /newbot → copy the token it gives you. Use a NEW bot for this
# app; sharing one bot between two apps fights over the webhook.
TELEGRAM_BOT_TOKEN=
# A random secret string YOU invent. Telegram sends it back on every webhook so
# the app can reject fake calls. `npm run webhook:set` registers it for you.
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated Telegram numeric user IDs allowed to use the bot (fail-closed:
# anyone not on this list is refused). Get yours from @userinfobot.
TELEGRAM_ALLOWED_USER_IDS=
# Your own Telegram numeric ID — where the brief, the proposals and the pack go.
OWNER_CHAT_ID=
# Optional: extra chat IDs (the CGI team group) to also receive the brief + pack.
TELEGRAM_TEAM_CHAT_IDS=

# ---- The crons ----
# REQUIRED. A random secret guarding /api/cron-daily and /api/cron-daily-gmail
# (both can spend credit, so they fail CLOSED — no secret set means 401 to everyone).
# Vercel Cron sends it automatically once you set the same value in Vercel env.
CRON_SECRET=

# ---- Regulatory Watch ----
# Set to false to switch off the Monday web search entirely (the mailbox watch
# keeps working). Anything else, or blank, means on.
REGWATCH_ENABLED=true

# ---- The mailbox watch (8am daily, /api/cron-daily-gmail) ----
# Composio reads the watched mailbox so forwarded circulars become proposed
# obligations and asks become actions. Read-only on Gmail — it never sends or deletes.
# Composio dashboard → Settings → API Keys. Create the key inside your PLATFORM
# project, with tool_execution: write — permissions can't be changed afterwards.
COMPOSIO_API_KEY=
# Composio dashboard → Connected Accounts → your Gmail → its id (starts with ca_).
# The connection must live in the same Platform project as the key above.
COMPOSIO_CONNECTED_ACCOUNT_ID=

# ---- 9) Outlook email to management (optional) ----
# The bot talks to YOU on Telegram. This sends the SAME morning brief by email to
# the people who don't live in Telegram, through your Outlook via Composio.
# Management reporting may send itself; the Overdue Chaser's reminders to HODs
# stay drafts you send yourself — that code path does not exist.
#
# Composio dashboard -> Connected Accounts -> Outlook -> its id (starts with ca_).
# Must live in the SAME Platform project as COMPOSIO_API_KEY above, and that key
# needs tool_execution: write.
COMPOSIO_OUTLOOK_ACCOUNT_ID=
# Nothing is emailed unless this is exactly "true".
MAIL_ENABLED=
# Who the brief is FOR, comma-separated. Used live; shown (not used) in pilot.
MAIL_TO=
# PILOT: anything other than "false" sends only to MAIL_PILOT_TO, with [PILOT] in
# the subject and a banner naming who it would have reached. Set to false to go live.
MAIL_PILOT=true
# Your own address, for the pilot.
MAIL_PILOT_TO=
